# RTDA local defaults
RTDA_BACKEND=dxgi
RTDA_TARGET_FPS=60
RTDA_MONITOR_INDEX=0

# Optional AI providers for standalone UI / AIClient.from_env
RTDA_AI_PROVIDER=groq
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOKENROUTER_API_KEY=
NVIDIA_API_KEY=

# Optional AI Provider Base URLs (overrides default API endpoints)
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
